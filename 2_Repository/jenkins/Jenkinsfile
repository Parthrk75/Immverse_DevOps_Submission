// BUILD ONCE -> SCAN -> SIGN -> publish digest -> open PR to promote to dev.  (NOT RUN: no Jenkins in sandbox)
// Everything downstream uses the digest produced here; the artifact is never rebuilt per environment.
pipeline {
  agent { kubernetes { yamlFile 'jenkins/agent-pod.yaml' } }
  options { timestamps(); disableConcurrentBuilds(); timeout(time: 45, unit: 'MINUTES') }
  environment {
    REGISTRY = 'ghcr.io/immverse/app'
    COSIGN_KEY = 'awskms:///alias/immverse-cosign'     // key lives in KMS, never on the agent
  }
  stages {
    stage('Policy gates (fast)') {
      parallel {
        stage('Tenant + residency')  { steps { sh 'python3 scripts/validate_tenants.py' } }
        stage('Migration lint')      { steps { sh 'python3 scripts/migration_lint.py ${MIGRATIONS_DIR:-migrations}'   // dir lives in the app repo checkout } }
        stage('Unit tests')          { steps { sh 'python3 -m unittest discover -s tests' } }
        stage('IaC scan')            { steps { sh 'trivy config --severity HIGH,CRITICAL --exit-code 1 infra/' } }
        stage('SonarQube')           { steps { withSonarQubeEnv('sonar') { sh 'sonar-scanner' }; timeout(10) { waitForQualityGate abortPipeline: true } } }
      }
    }
    stage('Build once') {
      steps {
        container('buildkit') {
          sh '''
            buildctl build --frontend dockerfile.v0 --local context=. --local dockerfile=. \
              --output type=image,name=${REGISTRY}:${GIT_COMMIT},push=true \
              --metadata-file build.json
            jq -r '.["containerimage.digest"]' build.json > digest.txt
          '''
        }
        script { env.DIGEST = readFile('digest.txt').trim() }
        echo "image digest: ${env.DIGEST}"
      }
    }
    stage('Scan image') {
      steps {
        sh 'trivy image --severity HIGH,CRITICAL --ignore-unfixed --exit-code 1 ${REGISTRY}@${DIGEST}'
        sh 'syft ${REGISTRY}@${DIGEST} -o spdx-json > sbom.spdx.json'
        archiveArtifacts 'sbom.spdx.json'
      }
    }
    stage('Sign + attest') {
      steps {
        sh 'cosign sign --yes --key ${COSIGN_KEY} ${REGISTRY}@${DIGEST}'
        sh 'cosign attest --yes --key ${COSIGN_KEY} --type spdxjson --predicate sbom.spdx.json ${REGISTRY}@${DIGEST}'
        sh 'cosign verify --key ${COSIGN_KEY} ${REGISTRY}@${DIGEST}'     // fail fast if signing is broken
      }
    }
    stage('Promote to dev (PR)') {
      when { branch 'main' }
      steps { sh 'python3 scripts/promote.py dev ${DIGEST} --pr' }
    }
  }
  post { failure { slackSend channel: '#deploys', message: "build failed ${env.BUILD_URL}" } }
}
