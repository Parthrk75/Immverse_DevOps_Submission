# Local Jenkins controller that can run docker/trivy/cosign/helm/kubectl itself (LOCAL DEMO; prod uses k8s agents).
FROM jenkins/jenkins:lts-jdk17
USER root
RUN apt-get update && apt-get install -y --no-install-recommends docker.io python3 python3-pip unzip jq curl \
    && rm -rf /var/lib/apt/lists/*
COPY install-tools.sh /tmp/install-tools.sh
RUN /tmp/install-tools.sh
USER jenkins
COPY plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt
